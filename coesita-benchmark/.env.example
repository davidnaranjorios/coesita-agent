# Coesita Benchmark — environment configuration
# Copy to .env and edit. Everything is optional: with no configuration the
# benchmark runs against the two built-in reference baselines (no network).

# ── Dashboard ────────────────────────────────────────────────────────────────
# Port the dashboard listens on (host side when using docker compose)
COESITA_DASHBOARD_PORT=5050

# Where benchmark artifacts and decision logs are stored.
# Default: ~/.coesita (bare install) or /data (Docker volume).
#COESITA_LOG_DIR=/data

# ── Frameworks / models to benchmark ─────────────────────────────────────────
# JSON map: name → chat-completions endpoint. Each entry becomes a column in
# the comparison table. The entry name should contain the framework slug so it
# matches its scan profile (e.g. "langgraph-app" matches the "langgraph" scan
# entry). api_key_env names the env var holding the key.
#
#COESITA_BENCHMARK_RUNNERS={"langgraph-app": {"model": "<your-model-id>", "base_url": "https://your-endpoint/v1", "api_key_env": "YOUR_API_KEY"}, "crewai-app": {"model": "<your-model-id>", "base_url": "https://your-endpoint/v1", "api_key_env": "YOUR_API_KEY"}}

# API keys referenced above (set whatever names you used in api_key_env)
#YOUR_API_KEY=...

# ── Optional integrations ────────────────────────────────────────────────────
# Embed a Kanban board (iframe) on the /benchmark page
#COESITA_KANBAN_URL=http://localhost:8080/board
